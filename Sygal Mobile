/* MOUVEMENTS STANDARD */
function openMvt(type,id){openMvtFor(id||sAct,type);}
function openMvtFor(id,type){
  mvtId=id;mvtType=type;
  var it=findId(id);
  document.getElementById('shMT').textContent=type==='in'?'Entree de stock':type==='out'?'Sortie de stock':'Ajustement';
  document.getElementById('shMA').textContent=it.name+(it.ref?' -- '+it.ref:'');
  var sel=document.getElementById('shME');
  sel.innerHTML='<option value="-1">Tous les emplacements</option>';
  (it.empls||[]).forEach(function(e,i){sel.innerHTML+='<option value="'+i+'">'+(e.loc||'Empl. '+(i+1))+' ('+e.qty+(it.unit?' '+it.unit:'')+')</option>';});
  sel.value='-1';updME();
  document.getElementById('shMQ').value='';
  document.getElementById('shMM').value='';
  document.getElementById('shMD').value=new Date().toISOString().slice(0,10);
  document.getElementById('shMQL').textContent=type==='in'?'Quantite a recevoir *':type==='out'?'Quantite a sortir *':'Nouveau stock total *';
  openSheet('shM','shMO');
  setTimeout(function(){document.getElementById('shMQ').focus();},300);
}
function updME(){
  if(!mvtId)return;
  var it=findId(mvtId);var sel=document.getElementById('shME');var v=sel.value;var cur=document.getElementById('shMC');
  if(v==='-1')cur.textContent='Total: '+totalStock(it)+(it.unit?' '+it.unit:'');
  else{var e=it.empls[parseInt(v)];cur.textContent=(e.loc||'Empl.')+': '+e.qty+(it.unit?' '+it.unit:'');}
}
function closeM(){closeSheet('shM','shMO');mvtId=null;mvtType=null;}
function saveM(){
  var qty=parseFloat(document.getElementById('shMQ').value);
  if(isNaN(qty)||qty<=0){alert('Quantite invalide.');return;}
  var motif=document.getElementById('shMM').value.trim();
  var date=document.getElementById('shMD').value||new Date().toISOString().slice(0,10);
  var it=findId(mvtId);if(!it)return;
  if(!it.empls||!it.empls.length)it.empls=[{loc:'',qty:0}];
  var sel=document.getElementById('shME');var v=sel.value;var emplName='';
  if(v==='-1'){
    if(mvtType==='in'){it.empls[0].qty=Math.round((it.empls[0].qty+qty)*1000)/1000;emplName='tous';}
    else if(mvtType==='out'){if(totalStock(it)<qty){alert('Stock insuffisant.');return;}var rem=qty;for(var i=0;i<it.empls.length&&rem>0;i++){var take=Math.min(it.empls[i].qty,rem);it.empls[i].qty=Math.round((it.empls[i].qty-take)*1000)/1000;rem=Math.round((rem-take)*1000)/1000;}emplName='tous';}
    else{var old=totalStock(it);if(old>0)for(var i=0;i<it.empls.length;i++)it.empls[i].qty=Math.round(it.empls[i].qty/old*qty*1000)/1000;else it.empls[0].qty=qty;emplName='ajust.';}
  } else {
    var idx=parseInt(v);var e=it.empls[idx];emplName=e.loc||'empl.'+(idx+1);
    if(mvtType==='in')e.qty=Math.round((e.qty+qty)*1000)/1000;
    else if(mvtType==='out'){if(qty>e.qty){alert('Stock insuffisant sur cet emplacement.');return;}e.qty=Math.round((e.qty-qty)*1000)/1000;}
    else e.qty=Math.round(qty*1000)/1000;
  }
  it.mvts.push({id:uid(),type:mvtType,qty:qty,motif:motif||'--',date:date,empl:emplName});
  trimMvts(it);
  save();renderAll();closeM();
}

