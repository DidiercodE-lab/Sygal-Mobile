function getEmpls(){var rows=document.getElementById('emplEd').querySelectorAll('.empl-row');var res=[];for(var i=0;i<rows.length;i++){var ins=rows[i].querySelectorAll('input');res.push({loc:ins[0].value.trim(),qty:parseFloat(ins[1].value)||0});}return res;}
function openA(id){
  editId=id||null;pendImg=undefined;updCatLA();
  document.getElementById('shAT').textContent=id?"Modifier l'article":'Nouvel article';
  var prev=document.getElementById('mIP'),ph=document.getElementById('mIPh'),rb=document.getElementById('rmImg');
  var ed=document.getElementById('emplEd');ed.innerHTML='';
  if(id){
    var it=findId(id);
    document.getElementById('fRef').value=it.ref||'';document.getElementById('fName').value=it.name;document.getElementById('fCat').value=it.cat||'';document.getElementById('fMin').value=it.min;document.getElementById('fMax').value=it.max;document.getElementById('fUnit').value=it.unit||'';document.getElementById('fSecu').value=it.secu||0;document.getElementById('fPu').value=it.pu||'';document.getElementById('fDlai').value=it.dlai||0;document.getElementById('fSupplier').value=it.supplier||'';document.getElementById('fNotes').value=it.notes||'';
    if(it.serialized){document.getElementById('fTypeSer').checked=true;document.getElementById('fTypeStd').checked=false;}else{document.getElementById('fTypeStd').checked=true;document.getElementById('fTypeSer').checked=false;}
    toggleSer();
    if(!it.serialized){var empls=it.empls||[];if(empls.length)for(var i=0;i<empls.length;i++)addEmplRow(empls[i].loc,empls[i].qty);else addEmplRow('',0);}
    if(it.img){prev.src=it.img;prev.style.display='block';ph.style.display='none';rb.style.display='inline-flex';}else{prev.style.display='none';ph.style.display='flex';rb.style.display='none';}
  } else {
    ['fRef','fName','fCat','fMin','fMax','fUnit','fSecu','fPu','fDlai','fSupplier','fNotes'].forEach(function(i){document.getElementById(i).value='';});
    document.getElementById('fTypeStd').checked=true;document.getElementById('fTypeSer').checked=false;toggleSer();
    addEmplRow('',0);prev.style.display='none';ph.style.display='flex';rb.style.display='none';
  }
  openSheet('shA','shAO');
  setTimeout(function(){document.getElementById('fName').focus();},300);
}
function closeA(){closeSheet('shA','shAO');editId=null;pendImg=undefined;}
function handleImg(e){var file=e.target.files[0];if(!file)return;if(file.size>1048576){alert('Image trop lourde (max 1 Mo).');return;}var r=new FileReader();r.onload=function(ev){pendImg=ev.target.result;var p=document.getElementById('mIP');p.src=pendImg;p.style.display='block';document.getElementById('mIPh').style.display='none';document.getElementById('rmImg').style.display='inline-flex';};r.readAsDataURL(file);e.target.value='';}
function removeImg(){pendImg=null;document.getElementById('mIP').style.display='none';document.getElementById('mIPh').style.display='flex';document.getElementById('rmImg').style.display='none';}
function saveA(){
  var name=document.getElementById('fName').value.trim();var min=parseFloat(document.getElementById('fMin').value);var max=parseFloat(document.getElementById('fMax').value);
  if(!name||isNaN(min)||isNaN(max)){alert('Nom, min et max sont obligatoires.');return;}if(min>max){alert('Le min ne peut pas etre superieur au max.');return;}
  var isSer=document.getElementById('fTypeSer').checked;
  var empls=isSer?[]:getEmpls();if(!isSer&&!empls.length)empls=[{loc:'',qty:0}];
  var imgVal;if(pendImg===null)imgVal='';else if(pendImg!==undefined)imgVal=pendImg;else{var ex=editId?findId(editId):null;imgVal=ex?(ex.img||''):'';}
  var data={ref:document.getElementById('fRef').value.trim(),name:name,cat:document.getElementById('fCat').value.trim(),min:min,max:max,unit:document.getElementById('fUnit').value.trim(),secu:parseFloat(document.getElementById('fSecu').value)||0,pu:parseFloat(document.getElementById('fPu').value)||0,dlai:parseFloat(document.getElementById('fDlai').value)||0,supplier:document.getElementById('fSupplier').value.trim(),notes:document.getElementById('fNotes').value.trim(),img:imgVal,serialized:isSer,empls:isSer?[]:empls};
  if(editId){for(var i=0;i<items.length;i++){if(items[i].id===editId){data.mvts=items[i].mvts||[];data.serials=items[i].serials||[];items[i]=Object.assign({},items[i],data);break;}}}
  else{data.id=uid();data.mvts=[];data.serials=[];items.push(data);}
  save();renderAll();closeA();
}
function delItem(id){
  if(!confirm('Supprimer cet article ?'))return;
  if(rAct===id)closeDrR();if(sAct===id)closeDrS();
  var arr=[];for(var i=0;i<items.length;i++)if(items[i].id!==id)arr.push(items[i]);
  items=arr;save();renderAll();
}

/* JOURNAL */
function lk(d){
  if(lockBuf.length>=4)return;
  lockBuf+=d;updLkDots();
  if(lockBuf.length===4){
    if(lockBuf===CODE){jUnlocked=true;document.getElementById('jLock').style.display='none';document.getElementById('jContent').style.display='block';renderJ();}
    else{document.getElementById('lkErr').textContent='Code incorrect';setTimeout(function(){lockBuf='';updLkDots();document.getElementById('lkErr').textContent='';},700);}
  }
}
function lkDel(){if(lockBuf.length>0){lockBuf=lockBuf.slice(0,-1);updLkDots();}}
function updLkDots(){for(var i=0;i<4;i++){var d=document.getElementById('ld'+i);if(d)d.className='lock-dot'+(i<lockBuf.length?' filled':'');}}
function lockJournal(){jUnlocked=false;lockBuf='';updLkDots();document.getElementById('jLock').style.display='block';document.getElementById('jContent').style.display='none';switchTab('r');}
function getAllMvts(){
  var all=[];
  for(var i=0;i<items.length;i++){var it=items[i];for(var j=0;j<(it.mvts||[]).length;j++){var m=Object.assign({},it.mvts[j],{_itemId:it.id,_itemName:it.name,_itemRef:it.ref||'',_unit:it.unit||''});all.push(m);}}
  all.sort(function(a,b){return (b.date||'').localeCompare(a.date||'');});
  return all;
}
function renderJ(){
  var q=(document.getElementById('qJ').value||'').toLowerCase();
  var tf=document.getElementById('tJ').value;
  var all=getAllMvts();
  var fil=all.filter(function(m){
    if(tf&&m.type!==tf)return false;
    if(q&&m._itemName.toLowerCase().indexOf(q)<0&&(m._itemRef||'').toLowerCase().indexOf(q)<0&&(m.motif||'').toLowerCase().indexOf(q)<0&&(m.empl||'').toLowerCase().indexOf(q)<0)return false;
    return true;
  });
  var tm=all.length;
  document.getElementById('mJ').innerHTML='<div class="metric"><div class="ml">Total</div><div class="mv">'+tm+'</div></div><div class="metric"><div class="ml">Entrees</div><div class="mv ok">'+all.filter(function(m){return m.type==='in';}).length+'</div></div><div class="metric"><div class="ml">Sorties</div><div class="mv crit">'+all.filter(function(m){return m.type==='out';}).length+'</div></div><div class="metric"><div class="ml">Ajust.</div><div class="mv warn">'+all.filter(function(m){return m.type==='adj';}).length+'</div></div>';
  if(!fil.length){document.getElementById('jList').innerHTML='<div class="empty"><i class="ti ti-search-off"></i>Aucun mouvement</div>';return;}
  var h='';
  for(var i=0;i<fil.length;i++){
    var m=fil[i];
    var ico=m.type==='in'?'ti-arrow-bar-down':m.type==='out'?'ti-arrow-bar-up':'ti-adjustments';
    var sign=m.type==='in'?'+':m.type==='out'?'-':'~';
    h+='<div class="j-row" data-item="'+esc(m._itemId)+'" data-mvt="'+esc(m.id)+'">'
      +'<div class="j-cb"><input type="checkbox"></div>'
      +'<div class="j-ico '+m.type+'"><i class="ti '+ico+'"></i></div>'
      +'<div class="j-body"><div class="j-art">'+(m._itemRef?esc(m._itemRef)+' - ':'')+esc(m._itemName)+'</div><div class="j-it">'+esc(m.motif||'--')+(m.empl&&m.empl!=='--'?' / '+esc(m.empl):'')+'</div></div>'
      +'<div class="j-right"><div class="j-q '+m.type+'">'+sign+m.qty+(m._unit?' '+esc(m._unit):'')+'</div><div class="j-date">'+esc(m.date||'')+'</div></div>'
    +'</div>';
  }
  document.getElementById('jList').innerHTML=h;
}
function jSelAll(){document.getElementById('jList').querySelectorAll('input[type=checkbox]').forEach(function(cb){cb.checked=true;});}
function jSelNone(){document.getElementById('jList').querySelectorAll('input[type=checkbox]').forEach(function(cb){cb.checked=false;});}
function jDelSel(){
  var rows=document.getElementById('jList').querySelectorAll('.j-row');
  var td=[];rows.forEach(function(row){if(row.querySelector('input').checked)td.push({itemId:row.dataset.item,mvtId:row.dataset.mvt});});
  if(!td.length){alert('Selectionnez au moins un mouvement.');return;}
  if(!confirm('Supprimer '+td.length+' mouvement(s) ?'))return;
  for(var i=0;i<td.length;i++){var it=findId(td[i].itemId);if(!it)continue;it.mvts=it.mvts.filter(function(m){return m.id!==td[i].mvtId;});}
  save();renderAll();
}
function jDelAll(){
  if(!confirm('Supprimer TOUS les mouvements ?'))return;
  for(var i=0;i<items.length;i++)items[i].mvts=[];
  save();renderAll();
}

/* SHEET UTILS */
function openSheet(shId,ovId){document.getElementById(shId).classList.add('open');document.getElementById(ovId).classList.add('open');}
function closeSheet(shId,ovId){document.getElementById(shId).classList.remove('open');document.getElementById(ovId).classList.remove('open');}

/* LIGHTBOX */
function lbOpen(id){var it=findId(id);if(!it||!it.img)return;document.getElementById('lbImg').src=it.img;document.getElementById('lb').classList.add('open');}
function lbClose(){document.getElementById('lb').classList.remove('open');}

/* IO */
function exportJSON(){var blob=new Blob([JSON.stringify({version:3,app:'SYGAL 1.0',exported:new Date().toISOString(),items:items},null,2)],{type:'application/json'});var a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download='sygal_'+new Date().toISOString().slice(0,10)+'.json';a.click();}
function importJSON(e){var file=e.target.files[0];if(!file)return;var r=new FileReader();r.onload=function(ev){try{var data=JSON.parse(ev.target.result);var imp=data.items||data;if(!Array.isArray(imp))throw new Error('Format invalide');items=imp.map(function(it){var empls=it.empls||(!it.serialized?[{loc:it.empl||'',qty:Number(it.stock)||0}]:[]);return{id:it.id||uid(),ref:it.ref||'',name:it.name||'?',cat:it.cat||'',min:Number(it.min)||0,max:Number(it.max)||0,unit:it.unit||'',secu:Number(it.secu)||0,pu:Number(it.pu)||0,dlai:Number(it.dlai)||0,supplier:it.supplier||'',notes:it.notes||'',img:it.img||'',mvts:it.mvts||[],empls:empls,serialized:!!it.serialized,serials:it.serials||[]};});save();renderAll();}catch(err){alert('Fichier invalide : '+err.message);}};r.readAsText(file);e.target.value='';}

load();
</script>
