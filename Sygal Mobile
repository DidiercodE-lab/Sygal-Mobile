<script>
var KEY='sygal_v3',MVT_MAX=40,CODE='1811';
var items=[];
var rAct=null,sAct=null,editId=null,pendImg=undefined;
var mvtId=null,mvtType=null,serItemId=null,serFilt='all';
var lockBuf='',jUnlocked=false;
var curTab='r';

function uid(){return Math.random().toString(36).slice(2,10);}
function esc(s){return String(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');}
function trimMvts(it){if(it.mvts&&it.mvts.length>MVT_MAX)it.mvts=it.mvts.slice(it.mvts.length-MVT_MAX);}

function totalStock(it){
  if(it.serialized){var c=0;for(var i=0;i<(it.serials||[]).length;i++) if(it.serials[i].status==='in')c++;return c;}
  var t=0;for(var i=0;i<(it.empls||[]).length;i++) t+=Number(it.empls[i].qty)||0;
  return Math.round(t*1000)/1000;
}
function stOf(it){var s=totalStock(it);if(s<=it.min)return'crit';if(s<=it.min*1.3)return'warn';return'ok';}
function stLbl(s){return s==='crit'?'Urgent':s==='warn'?'Surveiller':'OK';}
function bClr(s){return s==='crit'?'var(--crit-bar)':s==='warn'?'var(--warn-bar)':'var(--ok-bar)';}
function pct(it){var s=totalStock(it);return it.max?Math.min(100,Math.round(s/it.max*100)):0;}
function findId(id){for(var i=0;i<items.length;i++) if(items[i].id===id) return items[i]; return null;}
function getSerLocs(it){var l=[];(it.serials||[]).forEach(function(s){if(s.loc&&l.indexOf(s.loc)<0)l.push(s.loc);});return l;}

function load(){
  try{items=JSON.parse(localStorage.getItem(KEY)||'[]');}catch(e){items=[];}
  if(!items.length){
    var old=[];try{old=JSON.parse(localStorage.getItem('sygal_v2')||'[]');}catch(e){}
    if(old.length){
      items=old.map(function(it){var empls=it.empls||[{loc:it.empl||'',qty:Number(it.stock)||0}];return{id:it.id||uid(),ref:it.ref||'',name:it.name||'?',cat:it.cat||'',min:Number(it.min)||0,max:Number(it.max)||0,unit:it.unit||'',secu:Number(it.secu)||0,pu:Number(it.pu)||0,dlai:Number(it.dlai)||0,supplier:it.supplier||'',notes:it.notes||'',img:it.img||'',mvts:it.mvts||[],empls:empls,serialized:false,serials:[]};});
    } else {
      items=[
        {id:uid(),ref:'SYG-001',name:'Tissu serge noir',cat:'Matieres premieres',min:30,max:120,unit:'m',secu:10,pu:12.50,dlai:7,supplier:'Fournisseur A',notes:'Qualite premium',img:'',mvts:[],empls:[{loc:'Etagere A1',qty:30},{loc:'Reserve B2',qty:15}],serialized:false,serials:[]},
        {id:uid(),ref:'SYG-002',name:'Elastique 3cm',cat:'Mercerie',min:20,max:80,unit:'m',secu:5,pu:0.80,dlai:3,supplier:'',notes:'Commander urgent',img:'',mvts:[],empls:[{loc:'Tiroir B2',qty:8}],serialized:false,serials:[]},
        {id:uid(),ref:'SYG-003',name:'Outillage electrique',cat:'Materiel',min:2,max:10,unit:'pcs',secu:1,pu:450,dlai:14,supplier:'Pro Distrib',notes:'',img:'',mvts:[],empls:[],serialized:true,serials:[{sn:'OUT-2024-001',status:'in',loc:'Armoire A1',dateIn:'2024-01-10',dateOut:null,motif:''},{sn:'OUT-2024-002',status:'out',loc:'Armoire A1',dateIn:'2024-01-10',dateOut:'2024-11-05',motif:'Chantier Lyon'}]},
        {id:uid(),ref:'SYG-004',name:'Sac emballage',cat:'Expedition',min:50,max:200,unit:'pcs',secu:20,pu:0.60,dlai:5,supplier:'',notes:'',img:'',mvts:[],empls:[{loc:'',qty:12}],serialized:false,serials:[]}
      ];
    }
    save();
  }
  renderAll();
}
function save(){localStorage.setItem(KEY,JSON.stringify(items));}
function renderAll(){renderR();renderS();if(jUnlocked)renderJ();}

/* TABS */
function switchTab(t){
  curTab=t;
  ['r','s','j'].forEach(function(x){
    document.getElementById('tb'+x.toUpperCase()).classList.toggle('active',t===x);
    document.getElementById('page'+x.toUpperCase()).classList.toggle('active',t===x);
  });
  var titles={r:'Reapro',s:'Light Stock',j:'Journal'};
  document.getElementById('topTitle').textContent=titles[t]||'';
  var fab=document.getElementById('fabBtn');
  fab.style.display=(t==='r'||t==='s')?'flex':'none';
  if(t==='r')renderR();
  else if(t==='s')renderS();
  else if(t==='j'){if(!jUnlocked){lockBuf='';updLkDots();}else renderJ();}
}

/* CATS */
function getCats(){var c=[];for(var i=0;i<items.length;i++) if(items[i].cat&&c.indexOf(items[i].cat)<0) c.push(items[i].cat); return c.sort();}
function updCatLA(){document.getElementById('catLA').innerHTML=getCats().map(function(c){return'<option value="'+esc(c)+'">';}).join('');}

/* REAPRO */
function renderR(){
  var q=(document.getElementById('qR').value||'').toLowerCase();
  var st=document.getElementById('sR').value;
  var fil=items.filter(function(it){
    if(q&&it.name.toLowerCase().indexOf(q)<0&&(it.ref||'').toLowerCase().indexOf(q)<0&&(it.cat||'').toLowerCase().indexOf(q)<0)return false;
    if(st&&stOf(it)!==st)return false;
    return true;
  });
  var c=0,w=0,o=0,ser=0;
  for(var i=0;i<items.length;i++){var s=stOf(items[i]);if(s==='crit')c++;else if(s==='warn')w++;else o++;if(items[i].serialized)ser++;}
  document.getElementById('mR').innerHTML='<div class="metric"><div class="ml">Articles</div><div class="mv">'+items.length+'</div></div><div class="metric"><div class="ml">Urgent</div><div class="mv crit">'+c+'</div></div><div class="metric"><div class="ml">Surveiller</div><div class="mv warn">'+w+'</div></div><div class="metric"><div class="ml">OK</div><div class="mv ok">'+o+'</div></div>';
  if(!fil.length){document.getElementById('listR').innerHTML='<div class="empty"><i class="ti ti-search-off"></i>Aucun article</div>';return;}
  var h='';
  for(var i=0;i<fil.length;i++){
    var it=fil[i],s=stOf(it),p=pct(it),tot=totalStock(it);
    var img=it.img?'<img src="'+it.img+'" class="card-img" alt="'+esc(it.name)+'" onclick="event.stopPropagation();lbOpen(\''+it.id+'\')">'
      :'<div class="card-img-ph"><i class="ti ti-photo"></i></div>';
    var typeLbl=it.serialized?'<span class="badge ser" style="font-size:10px">N/S</span>':'';
    h+='<div class="card" onclick="openDrR(\''+it.id+'\')">'+
      '<div class="card-head">'+
        img+
        '<div class="card-info">'+
          '<div class="card-name">'+esc(it.name)+'</div>'+
          '<div class="card-ref">'+esc(it.ref||'--')+'&nbsp;'+typeLbl+'</div>'+
        '</div>'+
        '<div class="card-right">'+
          '<div class="card-stock">'+tot+'</div>'+
          '<div class="card-unit">'+esc(it.unit||'')+'</div>'+
          '<div class="card-bar-wrap"><div class="card-bar-fill" style="width:'+p+'%;background:'+bClr(s)+'"></div></div>'+
        '</div>'+
      '</div>'+
      '<div class="card-foot">'+
        '<span class="card-cat">'+esc(it.cat||'--')+'</span>'+
        '<span class="badge '+s+'">'+stLbl(s)+'</span>'+
      '</div>'+
    '</div>';
  }
  document.getElementById('listR').innerHTML=h;
}

/* LIGHT STOCK */
function renderS(){
  var q=(document.getElementById('qS').value||'').toLowerCase();
  var st=document.getElementById('sS').value;
  var fil=items.filter(function(it){
    if(q&&it.name.toLowerCase().indexOf(q)<0&&(it.ref||'').toLowerCase().indexOf(q)<0&&(it.cat||'').toLowerCase().indexOf(q)<0)return false;
