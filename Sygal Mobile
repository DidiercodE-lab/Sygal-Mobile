<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="default">
<title>SYGAL 1.0</title>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.19.0/dist/tabler-icons.min.css">
<style>
:root{
  --bg:#fdfcff;--bg2:#f3f0fa;--bg3:#ebe6f5;
  --text:#1a1a1a;--text2:#6b6b68;--accent:#5B35A8;--accent-fg:#fff;
  --border:rgba(91,53,168,.13);--border2:rgba(91,53,168,.25);
  --r:10px;--rl:14px;
  --crit-bg:#FCEBEB;--crit-t:#A32D2D;--crit-bar:#E24B4A;
  --warn-bg:#FAEEDA;--warn-t:#854F0B;--warn-bar:#EF9F27;
  --ok-bg:#EAF3DE;--ok-t:#3B6D11;--ok-bar:#639922;
  --info-bg:#E6F1FB;
  --ser-bg:#F0EEFA;--ser-t:#5B35A8;
  --tab-h:62px;--top-h:54px;
}
@media(prefers-color-scheme:dark){:root{
  --bg:#1a1726;--bg2:#221e32;--bg3:#2a2540;
  --text:#f0efea;--text2:#8a8a87;--accent:#9B7FDB;--accent-fg:#fff;
  --border:rgba(155,127,219,.18);--border2:rgba(155,127,219,.32);
  --crit-bg:#3a1a1a;--crit-t:#f09595;
  --warn-bg:#3a2c10;--warn-t:#FAC775;
  --ok-bg:#1a2e10;--ok-t:#C0DD97;
  --info-bg:#0c2240;
  --ser-bg:#1e1535;--ser-t:#b49ef5;
}}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent}
html,body{height:100%;overflow:hidden}
body{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',system-ui,sans-serif;background:var(--bg3);color:var(--text);font-size:15px}

/* TOP BAR */
.topbar{position:fixed;top:0;left:0;right:0;height:var(--top-h);background:var(--bg);border-bottom:0.5px solid var(--border);display:flex;align-items:center;padding:0 1rem;gap:10px;z-index:100;padding-top:env(safe-area-inset-top)}
.topbar-logo{font-size:17px;font-weight:700;color:var(--accent);letter-spacing:-.3px}
.topbar-logo small{font-size:11px;color:var(--text2);border:0.5px solid var(--border2);border-radius:3px;padding:1px 5px;font-weight:500;margin-left:4px}
.topbar-title{flex:1;font-size:16px;font-weight:600;color:var(--accent);text-align:center}
.topbar-btn{width:36px;height:36px;border:none;background:none;display:flex;align-items:center;justify-content:center;color:var(--text2);font-size:20px;cursor:pointer;border-radius:var(--r)}
.topbar-btn:active{background:var(--bg2)}

/* MAIN SCROLL AREA */
.main{position:fixed;top:var(--top-h);bottom:var(--tab-h);left:0;right:0;overflow-y:auto;-webkit-overflow-scrolling:touch}
.page{display:none;min-height:100%;padding:12px 12px 8px}
.page.active{display:block}

/* BOTTOM TAB BAR */
.tabbar{position:fixed;bottom:0;left:0;right:0;height:var(--tab-h);background:var(--bg);border-top:0.5px solid var(--border);display:grid;grid-template-columns:1fr 1fr 1fr;padding-bottom:env(safe-area-inset-bottom);z-index:100}
.tb{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:3px;border:none;background:none;cursor:pointer;color:var(--text2);font-size:10px;font-weight:500;font-family:inherit;padding:6px 0;transition:color .12s}
.tb i{font-size:22px}
.tb.active{color:var(--accent)}
.tb .tb-dot{width:4px;height:4px;border-radius:50%;background:var(--accent);display:none}
.tb.active .tb-dot{display:block}

/* BUTTONS */
button.btn{display:inline-flex;align-items:center;gap:5px;padding:8px 14px;font-size:14px;border:0.5px solid var(--border2);border-radius:var(--r);background:var(--bg);color:var(--text);cursor:pointer;font-family:inherit;transition:background .12s;white-space:nowrap;-webkit-appearance:none}
button.btn:active{background:var(--bg2)}
button.btn.primary{background:var(--accent);color:var(--accent-fg);border-color:var(--accent)}
button.btn.primary:active{opacity:.85}
button.btn.danger{border-color:var(--crit-t);color:var(--crit-t)}
button.btn.danger:active{background:var(--crit-bg)}
button.btn.success{border-color:var(--ok-t);color:var(--ok-t)}
button.btn.success:active{background:var(--ok-bg)}
button.btn.serial{border-color:var(--ser-t);color:var(--ser-t)}
button.btn.serial:active{background:var(--ser-bg)}
button.btn.sm{padding:6px 11px;font-size:13px}
button.btn.full{width:100%;justify-content:center}
button.btn:disabled{opacity:.35}
input,select,textarea{font-family:inherit;font-size:15px;color:var(--text);background:var(--bg);border:0.5px solid var(--border2);border-radius:var(--r);padding:10px 12px;outline:none;width:100%;-webkit-appearance:none;appearance:none}
input:focus,select:focus,textarea:focus{box-shadow:0 0 0 2px rgba(91,53,168,.22)}

/* METRICS */
.metrics{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-bottom:14px}
.metric{background:var(--ser-bg);border-radius:var(--r);padding:12px 14px}
.ml{font-size:11px;color:var(--accent);margin-bottom:3px;opacity:.85}
.mv{font-size:24px;font-weight:700;color:var(--accent)}
.mv.warn{color:var(--warn-t)}.mv.crit{color:var(--crit-t)}.mv.ok{color:var(--ok-t)}

/* FILTER BAR */
.fbar{display:flex;gap:8px;margin-bottom:12px;align-items:center}
.fbar input{flex:1}
.fbar select{width:auto;min-width:110px}

/* ARTICLE CARD */
.card{background:var(--bg);border:0.5px solid var(--border);border-radius:var(--rl);margin-bottom:10px;overflow:hidden;cursor:pointer;-webkit-tap-highlight-color:transparent;transition:box-shadow .12s}
.card:active{box-shadow:0 0 0 2px var(--accent)}
.card-head{display:flex;align-items:center;gap:12px;padding:12px}
.card-img{width:48px;height:48px;border-radius:8px;object-fit:cover;border:0.5px solid var(--border);flex-shrink:0}
.card-img-ph{width:48px;height:48px;border-radius:8px;border:0.5px dashed var(--border2);display:flex;align-items:center;justify-content:center;color:var(--text2);font-size:20px;flex-shrink:0}
.card-info{flex:1;min-width:0}
.card-name{font-size:15px;font-weight:600;color:var(--accent);overflow:hidden;text-overflow:ellipsis;white-space:nowrap;margin-bottom:2px}
.card-ref{font-size:11px;color:var(--text2);font-family:ui-monospace,monospace}
.card-right{display:flex;flex-direction:column;align-items:flex-end;gap:4px;flex-shrink:0}
.card-stock{font-size:17px;font-weight:700;color:var(--text)}
.card-unit{font-size:11px;color:var(--text2)}
.card-bar-wrap{height:4px;background:var(--bg3);border-radius:3px;overflow:hidden;width:60px;margin-top:2px}
.card-bar-fill{height:100%;border-radius:3px}
.card-foot{display:flex;align-items:center;justify-content:space-between;padding:8px 12px;background:var(--bg2);border-top:0.5px solid var(--border)}
.card-cat{font-size:11px;color:var(--text2)}
.badge{display:inline-block;padding:3px 8px;border-radius:4px;font-size:11px;font-weight:600}
.badge.ok{background:var(--ok-bg);color:var(--ok-t)}
.badge.warn{background:var(--warn-bg);color:var(--warn-t)}
.badge.crit{background:var(--crit-bg);color:var(--crit-t)}
.badge.ser{background:var(--ser-bg);color:var(--ser-t)}
.card-actions{display:flex;gap:6px;padding:8px 12px;border-top:0.5px solid var(--border)}
.card-actions button.btn{flex:1;justify-content:center;font-size:12px;padding:7px 6px}

/* LIGHTSTOCK ROW */
.ls-row{background:var(--bg);border:0.5px solid var(--border);border-radius:var(--rl);margin-bottom:10px;overflow:hidden;cursor:pointer}
.ls-row:active{box-shadow:0 0 0 2px var(--accent)}
.ls-head{display:flex;align-items:center;gap:10px;padding:11px 12px}
.ls-img{width:40px;height:40px;border-radius:7px;object-fit:cover;border:0.5px solid var(--border);flex-shrink:0}
.ls-img-ph{width:40px;height:40px;border-radius:7px;border:0.5px dashed var(--border2);display:flex;align-items:center;justify-content:center;color:var(--text2);font-size:17px;flex-shrink:0}
.ls-info{flex:1;min-width:0}
.ls-name{font-size:14px;font-weight:600;color:var(--accent);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.ls-sub{font-size:11px;color:var(--text2)}
.ls-right{text-align:right;flex-shrink:0}
.ls-stock{font-size:16px;font-weight:700;color:var(--text)}
.ls-val{font-size:11px;color:var(--text2)}
.ls-foot{display:flex;align-items:center;justify-content:space-between;padding:7px 12px;background:var(--bg2);border-top:0.5px solid var(--border)}
.ls-empl{font-size:11px;color:var(--text2);flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.ls-actions{display:flex;gap:5px;padding:8px 12px;border-top:0.5px solid var(--border)}
.ls-actions button.btn{flex:1;justify-content:center;font-size:12px;padding:7px 5px}

/* DRAWER (fiche article) */
.drawer-overlay{display:none;position:fixed;inset:0;background:rgba(0,0,0,.4);z-index:200}
.drawer-overlay.open{display:block}
.drawer{position:fixed;bottom:0;left:0;right:0;background:var(--bg);border-radius:var(--rl) var(--rl) 0 0;z-index:201;transform:translateY(100%);transition:transform .28s cubic-bezier(.32,1.22,.58,1);max-height:90vh;display:flex;flex-direction:column}
.drawer.open{transform:translateY(0)}
.drawer-handle{width:36px;height:4px;background:var(--border2);border-radius:2px;margin:10px auto 4px;flex-shrink:0}
.drawer-scroll{overflow-y:auto;-webkit-overflow-scrolling:touch;flex:1}
.drawer-head{display:flex;align-items:flex-start;gap:12px;padding:12px 16px;border-bottom:0.5px solid var(--border)}
.d-img{width:64px;height:64px;border-radius:10px;object-fit:cover;border:0.5px solid var(--border);flex-shrink:0;cursor:zoom-in}
.d-ph{width:64px;height:64px;border-radius:10px;border:0.5px dashed var(--border2);display:flex;align-items:center;justify-content:center;color:var(--text2);font-size:24px;flex-shrink:0}
.d-meta{flex:1;min-width:0}
.d-name{font-size:16px;font-weight:700;color:var(--accent);margin-bottom:3px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.d-ref{font-size:12px;color:var(--text2);font-family:ui-monospace,monospace;margin-bottom:6px}
.d-close{width:32px;height:32px;border:none;background:var(--bg2);border-radius:50%;display:flex;align-items:center;justify-content:center;color:var(--text2);font-size:18px;cursor:pointer;flex-shrink:0}
.d-barwrap{height:5px;background:var(--bg3);margin:0 16px 12px}
.d-barfill{height:100%}
.d-grid{display:grid;grid-template-columns:1fr 1fr}
.d-row{display:flex;justify-content:space-between;padding:9px 16px;border-bottom:0.5px solid var(--border);gap:8px}
.d-row:last-child{border-bottom:none}
.dk{font-size:13px;color:var(--text2)}
.dv{font-size:13px;font-weight:600;color:var(--text);text-align:right}
.d-section{padding:10px 16px;border-top:0.5px solid var(--border)}
.d-stitle{font-size:10px;font-weight:700;color:var(--accent);text-transform:uppercase;letter-spacing:.5px;margin-bottom:8px}
.d-notes{padding:8px 16px;font-size:13px;color:var(--text2);font-style:italic;border-top:0.5px solid var(--border)}
.d-foot{padding:12px 16px;border-top:0.5px solid var(--border);background:var(--bg2);display:flex;gap:8px;flex-wrap:wrap;padding-bottom:calc(12px + env(safe-area-inset-bottom));flex-shrink:0}
.d-foot button.btn{flex:1;justify-content:center;min-width:80px}

/* MVT LIST */
.mvt-list{display:flex;flex-direction:column;gap:5px;max-height:220px;overflow-y:auto}
.mvt-item{display:flex;align-items:center;gap:8px;padding:8px 10px;background:var(--bg2);border-radius:8px;font-size:13px}
.mvt-ico{width:26px;height:26px;border-radius:50%;display:flex;align-items:center;justify-content:center;flex-shrink:0;font-size:13px}
.mvt-ico.in{background:var(--ok-bg);color:var(--ok-t)}
.mvt-ico.out{background:var(--crit-bg);color:var(--crit-t)}
.mvt-ico.adj{background:var(--warn-bg);color:var(--warn-t)}
.mvt-body{flex:1;min-width:0}
.mvt-t{font-weight:600;color:var(--text);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.mvt-s{color:var(--text2);font-size:11px}
.mvt-q{font-weight:700;white-space:nowrap}
.mvt-q.in{color:var(--ok-t)}.mvt-q.out{color:var(--crit-t)}.mvt-q.adj{color:var(--warn-t)}

/* SER LIST */
.ser-list{display:flex;flex-direction:column;gap:4px;max-height:200px;overflow-y:auto}
.ser-item{display:flex;align-items:center;gap:8px;padding:8px 10px;background:var(--bg2);border-radius:8px;font-size:13px}
.ser-sn{font-family:ui-monospace,monospace;font-weight:600;color:var(--text);flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.ser-info{font-size:11px;color:var(--text2);text-align:right}
.ser-st{font-size:11px;font-weight:700}
.ser-st.in{color:var(--ok-t)}.ser-st.out{color:var(--crit-t)}

/* BOTTOM SHEET (modal) */
.sheet-overlay{display:none;position:fixed;inset:0;background:rgba(0,0,0,.42);z-index:300}
.sheet-overlay.open{display:block}
.sheet{position:fixed;bottom:0;left:0;right:0;background:var(--bg);border-radius:var(--rl) var(--rl) 0 0;z-index:301;transform:translateY(100%);transition:transform .26s cubic-bezier(.32,1.22,.58,1);max-height:92vh;display:flex;flex-direction:column}
.sheet.open{transform:translateY(0)}
.sheet-handle{width:36px;height:4px;background:var(--border2);border-radius:2px;margin:10px auto 0;flex-shrink:0}
.sheet-inner{overflow-y:auto;-webkit-overflow-scrolling:touch;flex:1;padding:14px 16px;padding-bottom:calc(14px + env(safe-area-inset-bottom))}
.sheet h3{font-size:16px;font-weight:700;color:var(--accent);margin-bottom:14px}
.field{margin-bottom:12px}
.field label{display:block;font-size:12px;color:var(--text2);margin-bottom:4px;font-weight:500}
.g2{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.g3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:8px}
.sep{height:0.5px;background:var(--border);margin:14px 0}
.slabel{font-size:10px;font-weight:700;color:var(--accent);text-transform:uppercase;letter-spacing:.5px;margin-bottom:8px}
.mfoot{display:flex;gap:10px;margin-top:14px;padding-top:14px;border-top:0.5px solid var(--border)}
.mfoot button.btn{flex:1;justify-content:center;padding:11px}
.empl-row{display:flex;gap:6px;align-items:center;margin-bottom:8px}
.empl-row input.loc{flex:1}
.empl-row input.qty{width:75px;flex:none}
.img-row{display:flex;align-items:center;gap:12px;margin-bottom:12px}
.mimg{width:56px;height:56px;border-radius:10px;object-fit:cover;border:0.5px solid var(--border)}
.mph{width:56px;height:56px;border-radius:10px;border:0.5px dashed var(--border2);display:flex;align-items:center;justify-content:center;color:var(--text2);font-size:22px}
.ser-check-list{display:flex;flex-direction:column;gap:6px;max-height:250px;overflow-y:auto;margin-top:8px}
.ser-check-item{display:flex;align-items:center;gap:10px;padding:9px 12px;background:var(--bg2);border-radius:8px;font-size:14px}
.ser-check-item input[type=checkbox]{width:20px;height:20px;flex-shrink:0;accent-color:var(--accent)}
.ser-check-sn{font-family:ui-monospace,monospace;font-weight:600;flex:1}
.ser-check-info{font-size:11px;color:var(--text2)}

/* LIGHTBOX */
.lb{display:none;position:fixed;inset:0;background:rgba(0,0,0,.88);z-index:500;align-items:center;justify-content:center}
.lb.open{display:flex}
.lb-img{max-width:96vw;max-height:88vh;border-radius:10px;object-fit:contain}
.lb-x{position:fixed;top:16px;right:16px;color:#fff;font-size:28px;cursor:pointer;background:none;border:none;opacity:.8;width:44px;height:44px;display:flex;align-items:center;justify-content:center}

/* JOURNAL */
.j-row{display:flex;align-items:center;gap:10px;padding:10px 12px;background:var(--bg);border-bottom:0.5px solid var(--border)}
.j-row:last-child{border-bottom:none}
.j-ico{width:28px;height:28px;border-radius:50%;display:flex;align-items:center;justify-content:center;flex-shrink:0;font-size:14px}
.j-ico.in{background:var(--ok-bg);color:var(--ok-t)}
.j-ico.out{background:var(--crit-bg);color:var(--crit-t)}
.j-ico.adj{background:var(--warn-bg);color:var(--warn-t)}
.j-body{flex:1;min-width:0}
.j-art{font-weight:600;font-size:13px;color:var(--text);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.j-it{font-size:12px;color:var(--text2);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.j-right{text-align:right;flex-shrink:0}
.j-q{font-weight:700;font-size:14px}
.j-q.in{color:var(--ok-t)}.j-q.out{color:var(--crit-t)}.j-q.adj{color:var(--warn-t)}
.j-date{font-size:11px;color:var(--text2)}
.j-cb input{width:20px;height:20px;accent-color:var(--accent)}

/* LOCK */
.lock-wrap{display:flex;flex-direction:column;align-items:center;justify-content:center;min-height:60vh;gap:16px;padding:2rem}
.lock-card{background:var(--bg);border:0.5px solid var(--border);border-radius:var(--rl);padding:28px 24px;max-width:300px;width:100%;display:flex;flex-direction:column;align-items:center;gap:14px}
.lock-card h2{font-size:18px;font-weight:700;color:var(--accent)}
.lock-card p{font-size:13px;color:var(--text2);text-align:center}
.lock-dots{display:flex;gap:12px}
.lock-dot{width:13px;height:13px;border-radius:50%;background:var(--border2);transition:background .12s}
.lock-dot.filled{background:var(--accent)}
.lock-pad{display:grid;grid-template-columns:1fr 1fr 1fr;gap:10px;width:220px}
.lock-pad button{height:52px;font-size:20px;font-weight:600;border-radius:var(--r);background:var(--bg2);border:0.5px solid var(--border);color:var(--text);cursor:pointer;font-family:inherit;display:flex;align-items:center;justify-content:center}
.lock-pad button:active{background:var(--ser-bg);color:var(--accent)}
.lock-err{font-size:13px;color:var(--crit-t);min-height:18px;text-align:center}

/* EMPTY + MISC */
.empty{text-align:center;padding:3rem 1rem;color:var(--text2);font-size:14px}
.empty i{font-size:36px;display:block;margin-bottom:10px;opacity:.5}
.section-wrap{background:var(--bg);border:0.5px solid var(--border);border-radius:var(--rl);overflow:hidden;margin-bottom:12px}
.fab{position:fixed;bottom:calc(var(--tab-h) + 16px);right:16px;width:52px;height:52px;border-radius:50%;background:var(--accent);color:var(--accent-fg);border:none;display:flex;align-items:center;justify-content:center;font-size:24px;cursor:pointer;box-shadow:0 4px 16px rgba(91,53,168,.35);z-index:99}
.fab:active{opacity:.85}
.chip{display:inline-block;background:var(--bg3);border-radius:4px;padding:2px 6px;font-size:11px;margin-right:3px;margin-bottom:2px;white-space:nowrap}
.top-actions{display:flex;gap:8px;margin-bottom:12px;flex-wrap:wrap}
.top-actions button.btn{flex:1;justify-content:center;min-width:80px}
</style>
</head>
<body>

<!-- TOP BAR -->
<div class="topbar" id="topbar">
  <span class="topbar-logo">SYGAL<small>1.0</small></span>
  <span class="topbar-title" id="topTitle">Reapro</span>
  <button class="topbar-btn" onclick="document.getElementById('impM').click()" title="Importer"><i class="ti ti-download"></i></button>
  <input type="file" id="impM" accept=".json" style="display:none" onchange="importJSON(event)">
  <button class="topbar-btn" onclick="exportJSON()" title="Exporter"><i class="ti ti-upload"></i></button>
</div>

<!-- PAGES -->
<div class="main">

  <!-- REAPRO -->
  <div class="page active" id="pageR">
    <div class="metrics" id="mR"></div>
    <div class="fbar">
      <input type="text" id="qR" placeholder="Rechercher..." oninput="renderR()">
      <select id="sR" onchange="renderR()" style="width:auto">
        <option value="">Tous</option>
        <option value="crit">Urgent</option>
        <option value="warn">Surveiller</option>
        <option value="ok">OK</option>
      </select>
    </div>
    <div id="listR"></div>
  </div>

  <!-- LIGHT STOCK -->
  <div class="page" id="pageS">
    <div class="metrics" id="mS"></div>
    <div class="fbar">
      <input type="text" id="qS" placeholder="Rechercher..." oninput="renderS()">
      <select id="sS" onchange="renderS()" style="width:auto">
        <option value="">Tous</option>
        <option value="crit">Urgent</option>
        <option value="warn">Surveiller</option>
        <option value="ok">OK</option>
      </select>
    </div>
    <div id="listS"></div>
  </div>

