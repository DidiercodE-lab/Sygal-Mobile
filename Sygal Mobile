  openSheet('shSI','shSIO');
}
function closeSI(){closeSheet('shSI','shSIO');serItemId=null;}
function saveSI(){
  var sns=document.getElementById('siSns').value.trim().split('\n').map(function(s){return s.trim();}).filter(function(s){return s.length>0;});
  if(!sns.length){alert('Entrez au moins un numero de serie.');return;}
  var loc=document.getElementById('siLoc').value.trim();
  var date=document.getElementById('siDate').value||new Date().toISOString().slice(0,10);
  var motif=document.getElementById('siRef').value.trim();
  var it=findId(serItemId);if(!it)return;
  if(!it.serials)it.serials=[];
  var existing=it.serials.map(function(s){return s.sn;});
  var added=0,dupes=[];
  for(var i=0;i<sns.length;i++){
    if(existing.indexOf(sns[i])>=0){dupes.push(sns[i]);continue;}
    it.serials.push({sn:sns[i],status:'in',loc:loc,dateIn:date,dateOut:null,motif:motif});
    added++;
  }
  it.mvts.push({id:uid(),type:'in',qty:added,motif:motif||'Entree N/S',date:date,empl:loc||'--'});
  trimMvts(it);
  save();renderAll();
  alert(added+' N/S ajoute(s).'+(dupes.length?'\n'+dupes.length+' doublon(s) ignore(s).':''));
  closeSI();
}
